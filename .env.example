# Supabase (Auth + Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Server-only. Bypasses security rules, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=media

# Redis for the job queue
REDIS_URL=redis://127.0.0.1:6379

# "mock" works offline with no keys
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
VOICE_PROVIDER=mock
VIDEO_PROVIDER=mock

# Only needed when TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Secret used to verify signed provider webhooks
WEBHOOK_SIGNING_SECRET=replace-me